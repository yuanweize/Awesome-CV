% Modern, ATS-safe presentation layer shared by the résumé and cover letter.
% Keep the upstream-derived class as the structural engine and override visual
% tokens here so future template updates remain reviewable.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{modern-resume}[2026/08/03 v1.1 Modern Awesome-CV presentation]

\definecolor{modernNavy}{HTML}{17324D}
\definecolor{modernText}{HTML}{0F172A}
\definecolor{modernMuted}{HTML}{52606D}
\definecolor{modernBody}{HTML}{1F2937}
\definecolor{modernSecondary}{HTML}{475569}
\definecolor{modernMetadata}{HTML}{64748B}
\definecolor{modernRule}{HTML}{CBD5E1}
\colorlet{awesome}{modernNavy}
\colorlet{text}{modernText}
\colorlet{darktext}{modernText}
\colorlet{graytext}{modernMuted}
\colorlet{lighttext}{modernMuted}
\colorlet{sectiondivider}{modernRule}
\setbool{acvSectionColorHighlight}{false}

% Source Sans 3 is already configured by awesome-cv.cls. Use regular and
% semibold/bold weights: the previous Light body was difficult to scan.
\renewcommand*{\headerfont}{\sffamily}
\renewcommand*{\headerfontlight}{\sffamily}
\renewcommand*{\bodyfont}{\sffamily}
\renewcommand*{\bodyfontlight}{\sffamily}

\renewcommand*{\headerfirstnamestyle}[1]{{\fontsize{28pt}{31pt}\headerfont\mdseries\color{modernText}#1}}
\renewcommand*{\headerlastnamestyle}[1]{{\fontsize{28pt}{31pt}\headerfont\bfseries\color{modernText}#1}}
\renewcommand*{\headerpositionstyle}[1]{{\fontsize{11pt}{13pt}\bodyfont\bfseries\color{modernNavy}#1}}
\renewcommand*{\headeraddressstyle}[1]{{\fontsize{9.6pt}{11.5pt}\bodyfont\mdseries\color{modernMuted}#1}}
\renewcommand*{\headersocialstyle}[1]{{\fontsize{9.6pt}{11.5pt}\bodyfont\mdseries\color{modernText}#1}}
\renewcommand*{\headerquotestyle}[1]{{\fontsize{9.8pt}{12pt}\bodyfont\itshape\color{modernMuted}#1}}
\renewcommand*{\footerstyle}[1]{{\fontsize{8pt}{9pt}\bodyfont\color{modernMuted}#1}}

\renewcommand*{\sectionstyleface}[1]{{\fontsize{13pt}{15pt}\bodyfont\bfseries#1}}
\renewcommand*{\sectionstyle}[1]{\color{modernNavy}\sectionstyleface{#1}}
\renewcommand*{\paragraphstyle}{\fontsize{10pt}{12.6pt}\bodyfont\upshape\color{modernText}}

\renewcommand*{\entrytitlestyle}[1]{{\fontsize{10.8pt}{12.8pt}\bodyfont\bfseries\color{modernText}#1}}
\renewcommand*{\entrypositionstyle}[1]{{\fontsize{9.4pt}{11.2pt}\bodyfont\bfseries\color{modernMuted}#1}}
\renewcommand*{\entrydatestyle}[1]{{\fontsize{9.2pt}{11pt}\bodyfont\mdseries\color{modernMuted}#1}}
\renewcommand*{\entrylocationstyle}[1]{{\fontsize{9.2pt}{11pt}\bodyfont\mdseries\color{modernMuted}#1}}
\renewcommand*{\descriptionstyle}[1]{{\fontsize{9.8pt}{12.2pt}\bodyfont\upshape\color{modernText}#1}}
\renewcommand*{\skilltypestyle}[1]{{\fontsize{9.8pt}{12pt}\bodyfont\bfseries\color{modernNavy}#1}}
\renewcommand*{\skillsetstyle}[1]{{\fontsize{9.8pt}{12pt}\bodyfont\color{modernText}#1}}

% Cover-letter typography uses the same visual identity as the résumé. Keep
% the body regular weight and high contrast; the upstream Light/grey defaults
% are difficult to scan and visually disconnect the two application files.
\renewcommand*{\recipienttitlestyle}[1]{{\fontsize{10.4pt}{12.4pt}\bodyfont\bfseries\color{modernText}#1}}
\renewcommand*{\recipientaddressstyle}[1]{{\fontsize{9.5pt}{11.8pt}\bodyfont\mdseries\color{modernMuted}#1}}
\renewcommand*{\lettertitlestyle}[1]{{\fontsize{13pt}{15.5pt}\bodyfont\bfseries\color{modernNavy}#1}}
\renewcommand*{\letterdatestyle}[1]{{\fontsize{9.4pt}{11.5pt}\bodyfont\mdseries\color{modernMuted}#1}}
\renewcommand*{\lettertextstyle}{\fontsize{10.2pt}{14.2pt}\bodyfont\upshape\color{modernText}}
\renewcommand*{\letternamestyle}[1]{{\fontsize{10.2pt}{12.2pt}\bodyfont\bfseries\color{modernText}#1}}
\renewcommand*{\letterenclosurestyle}[1]{{\fontsize{9.2pt}{11pt}\bodyfont\mdseries\color{modernMuted}#1}}

\renewcommand{\acvHeaderAfterNameSkip}{0.7mm}
\renewcommand{\acvHeaderAfterPositionSkip}{0.7mm}
\renewcommand{\acvHeaderAfterAddressSkip}{0mm}
\renewcommand{\acvHeaderAfterSocialSkip}{3.5mm}
\renewcommand{\acvSectionTopSkip}{3.8mm}
\renewcommand{\acvSectionContentTopSkip}{3.0mm}
\renewcommand{\acvHeaderSocialSep}{\BeginAccSupp{ActualText={}}\enskip\textcolor{modernRule}{\textbar}\enskip\EndAccSupp{}}

\hypersetup{colorlinks=true,urlcolor=modernNavy,linkcolor=modernNavy}
\urlstyle{same}

% ATS text extraction must not contain discretionary soft hyphens. Accept the
% unhyphenated line-breaking pass and provide a small amount of emergency stretch
% before TeX considers protruding text. Explicit source hyphens remain printable.
\pretolerance=10000
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=1.5em

% Project links shown as entry metadata should be quieter than navigation in
% the header. These helpers keep GitHub and other repository links clickable,
% typographically consistent, and safe for characters such as underscores.
\newcommand*{\cvprojectlink}[2]{%
  \href{#1}{\textcolor{modernMuted}{\nolinkurl{#2}}}%
}
\newcommand*{\cvgithubrepo}[1]{%
  \cvprojectlink{https://github.com/#1}{github.com/#1}%
}

% Recruiter-facing links use short, labelled actions instead of dominant raw
% URLs.  \casestudylink is intentionally empty in standalone CV builds; the
% combined CV+portfolio source redefines it to a named internal destination.
\newcommand*{\cvactionlink}[2]{%
  \href{#1}{\textcolor{modernNavy}{\bfseries #2~$\nearrow$}}%
}
\providecommand*{\casestudylink}[2]{}

% Compact metadata used by Golden Portfolio pages. Mutable GitHub numbers must
% include an explicit snapshot date in the caller text.
\newcommand*{\cvmetarow}[1]{%
  {\fontsize{8.2pt}{10pt}\selectfont\bodyfont\color{modernMuted}#1\par}%
}

% A compact parent-child pattern for project-based work beneath one contractual
% employer. Keep the text in source order for ATS extraction while using a
% restrained left rule and indentation to make the relationship immediately
% visible to a human reader.
\newcommand*{\cvassignmentslabel}[1]{%
  \par\vspace{1.5mm}%
  {\fontsize{8.3pt}{10pt}\selectfont\bodyfont\bfseries\color{modernNavy}%
    \MakeUppercase{#1}\par}%
  \vspace{.6mm}%
}

\newcommand*{\cvassignment}[4]{%
  \par\noindent\hspace*{3mm}%
  {\color{modernRule}\vrule width .65pt}%
  \hspace{2.4mm}%
  \begin{minipage}[t]{\dimexpr\linewidth-6.1mm\relax}
    {\fontsize{9.6pt}{11.5pt}\selectfont\bodyfont\bfseries\color{modernText}#1}%
    \hfill
    {\fontsize{8.8pt}{10.6pt}\selectfont\bodyfont\mdseries\color{modernMuted}#2}\par
    {\fontsize{8.8pt}{10.6pt}\selectfont\bodyfont\mdseries\color{modernMuted}#3}\par
    \vspace{.35mm}%
    {\raggedright\fontsize{9.3pt}{11.4pt}\selectfont\bodyfont\color{modernText}#4\par}%
  \end{minipage}%
  \par\vspace{1.15mm}%
}

% Golden-Pack child entry with one compact, consistently styled location/date
% line. The normal document flow determines the block height, so the next
% cventry cannot collide with a multi-line assignment description.
\newcommand*{\cvgoldenassignment}[3]{%
  \par\noindent\hspace*{3mm}%
  {\color{modernRule}\vrule width .65pt}%
  \hspace{2.4mm}%
  \begin{minipage}[t]{\dimexpr\linewidth-6.1mm\relax}
    \noindent\begin{tabularx}{\linewidth}{@{}X>{\RaggedLeft\arraybackslash}p{.58\linewidth}@{}}
      {\fontsize{9.6pt}{11.5pt}\selectfont\bodyfont\bfseries\color{modernText}#1} &
      {\fontsize{8.8pt}{10.6pt}\selectfont\bodyfont\mdseries\color{modernMuted}#2}
    \end{tabularx}
    \vspace{.35mm}%
    {\raggedright\fontsize{9.3pt}{11.4pt}\selectfont\bodyfont\color{modernText}#3\par}%
  \end{minipage}%
  \par\vspace{1.05mm}%
}
