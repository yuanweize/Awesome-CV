  ${CYAN}build${RESET} [profile]       Build the CV + cover-letter application bundle
  ${CYAN}new${RESET} <profile>         Create a clean profile from public templates
  ${CYAN}clone${RESET} <src> <new>     Clone a profile without stale PDFs
  ${CYAN}diff${RESET} <a> [b]          Compare two profiles (b = current working if omitted)
  ${CYAN}current${RESET}               Show the active profile name
  ${CYAN}archive${RESET} <profile>     Dry-run a verified archive move; add --apply to move
  ${CYAN}archive-research${RESET} ...  Archive private research separately with verification
  ${CYAN}github-audit${RESET} ...      Audit public repositories, metrics, and Actions workflows
  ${CYAN}portfolio-audit${RESET} ...   Compare GitHub inventory with governed career memory
  ${CYAN}role-audit${RESET} ...        Compare interests, readiness, and claim coverage
  ${CYAN}legacy-audit${RESET} ...      Compare private historical CV wording with atomic claims
  ${CYAN}tech-audit${RESET} ...        Run local technology inventory; safe mode by default
  ${CYAN}delete${RESET} <profile>      Permanently delete after exact confirmation
  ${CYAN}context${RESET} [options]     Export evidence-bound AI context from a JD
  ${CYAN}status${RESET} [--json]       Report memory, application, profile, and warning state
  ${CYAN}start${RESET} [options]       Create a private JD + application-manifest workspace
  ${CYAN}manifest${RESET} <command>    Validate an application decision/bullet manifest
  ${CYAN}validate${RESET} [yaml]       Validate the private master database
  ${CYAN}privacy-check${RESET}         Check tracked files for private data/secrets
  ${CYAN}pdf-audit${RESET} <pdf>       Check page use, extractable text, and readable-type proxies
  ${CYAN}bundle-audit${RESET} <manifest> Audit every declared CV/cover-letter PDF and hash
  ${CYAN}track${RESET} <command>       Maintain the private application/outcome memory
  ${CYAN}doctor${RESET}                Audit workspace, roles, portfolio, tests, privacy, and profile drift

${BOLD}Examples:${RESET}
  ./cv init                     # First-time, idempotent private workspace setup
  ./cv list                     # See all profiles
  ./cv use acme-systems         # Switch to one application snapshot
  ./cv save                     # Save changes to current profile
  ./cv build acme-systems       # Build another profile without switching
  ./cv new acme-systems         # Create a clean profile from public templates
  ./cv clone prior-good acme    # Optionally reuse a trusted layout
  ./cv diff acme beta           # Compare two application snapshots
  ./cv archive old-role         # Plan only; no files move
  ./cv archive old-role --apply # Move after review and write SHA-256 manifest
  ./cv archive-research profiles/old/interview_prep old-interview --apply
