#!/usr/bin/env bash
set -euo pipefail

#───────────────────────────────────────────────────────────────────────────────
# CV Profile Manager
# Manage per-company CV / Cover Letter profiles.
#
# Each profile stores the files that change between job applications:
#   config.tex, letter_config.tex, sections/*.tex, and compiled PDFs.
#
# Shared structural files (src/main.tex, src/coverletter.tex, src/awesome-cv.cls)
# are NOT profiled — they are common infrastructure tracked by git.
#───────────────────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Keep Python bytecode outside the project even when users invoke ./cv directly.
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-/tmp/awesome-cv-pycache}"
PROFILES_DIR="$SCRIPT_DIR/profiles"
ACTIVE_FILE="$SCRIPT_DIR/.active_profile"
SECTIONS_DIR="$SCRIPT_DIR/sections"
BUILD_DIR="$SCRIPT_DIR/build"
ARCHIVE_DIR="$SCRIPT_DIR/archive/applications"

# Files that compose a profile
ROOT_FILES=(config.tex letter_config.tex)
SECTION_FILES=(order.tex summary.tex experience.tex skills.tex letter_body.tex education.tex certificates.tex honors.tex)

# ── Colors ────────────────────────────────────────────────────────────────────
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'

# ── Helpers ───────────────────────────────────────────────────────────────────
get_current() {
    if [[ -f "$ACTIVE_FILE" ]]; then
        [[ ! -L "$ACTIVE_FILE" ]] || die "Active-profile marker must not be a symbolic link."
        local current
        current=$(cat "$ACTIVE_FILE")
        if [[ -n "$current" ]]; then
            validate_profile_name "$current"
        fi
        echo "$current"
    else
        echo ""
    fi
}

die() { echo -e "${RED}Error:${RESET} $*" >&2; exit 1; }

validate_profile_name() {
    local profile="$1"
    [[ "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
        && [[ "$profile" != *..* ]] \
        || die "Invalid profile name '$profile'. Use letters, numbers, dot, underscore, or hyphen; '..' is forbidden."
}

ensure_profiles_root() {
    [[ ! -L "$PROFILES_DIR" ]] || die "profiles/ must not be a symbolic link."
    mkdir -p "$PROFILES_DIR"
    [[ -d "$PROFILES_DIR" ]] || die "profiles/ is not a directory."
}

assert_safe_profile_dir() {
    local profile="$1"
    local profile_dir="$PROFILES_DIR/$profile"
    [[ ! -L "$profile_dir" ]] || die "Profile '$profile' must not be a symbolic link."
    [[ -d "$profile_dir" ]] || die "Profile '$profile' not found."
    [[ ! -L "$profile_dir/sections" ]] || die "Profile '$profile' has an unsafe sections symlink."
}

assert_profile_files_are_regular() {
    local profile_dir="$1"
    local file
    for file in "${ROOT_FILES[@]}"; do
        [[ ! -L "$profile_dir/$file" ]] || die "Profile contains unsafe symlink: $file"
    done
    for file in "${SECTION_FILES[@]}"; do
        [[ ! -L "$profile_dir/sections/$file" ]] || die "Profile contains unsafe symlink: sections/$file"
    done
}

assert_working_files_are_regular() {
    [[ ! -L "$SECTIONS_DIR" ]] || die "sections/ must not be a symbolic link."
    local file
    for file in "${ROOT_FILES[@]}"; do
        [[ ! -L "$SCRIPT_DIR/$file" ]] || die "Working file must not be a symbolic link: $file"
    done
    for file in "${SECTION_FILES[@]}"; do
        [[ ! -L "$SECTIONS_DIR/$file" ]] || die "Working file must not be a symbolic link: sections/$file"
    done
}

assert_visible_skills_file() {
    local skills_file="$1"
    [[ -f "$skills_file" && ! -L "$skills_file" ]] \
        || die "Skills section is missing: $skills_file"
    grep -Eq '^[[:space:]]*\\cvskill([[:space:]]|$)' "$skills_file" \
        || die "Skills section has no visible \\cvskill entries: $skills_file"
}

write_active() {
    local profile="$1"
    [[ ! -L "$ACTIVE_FILE" ]] || die "Active-profile marker must not be a symbolic link."
    printf '%s\n' "$profile" > "$ACTIVE_FILE"
}

files_differ() {
    local first="$1"
    local second="$2"
    if [[ -L "$first" ]] || [[ -L "$second" ]]; then
        return 0
    fi
    if [[ -f "$first" ]] && [[ -f "$second" ]]; then
        ! cmp -s "$first" "$second"
        return
    fi
    [[ -e "$first" ]] || [[ -e "$second" ]]
}

working_tree_differs_from_profile() {
    local profile="$1"
    local profile_dir="$PROFILES_DIR/$profile"
    local file
    for file in "${ROOT_FILES[@]}"; do
        files_differ "$SCRIPT_DIR/$file" "$profile_dir/$file" && return 0
    done
    for file in "${SECTION_FILES[@]}"; do
        files_differ "$SECTIONS_DIR/$file" "$profile_dir/sections/$file" && return 0
    done
    return 1
}

ensure_switch_is_safe() {
    local force="${1:-}"
    [[ "$force" == "--force" ]] && return 0
    local current
    current=$(get_current)
    if [[ -z "$current" ]]; then
        local file
        for file in "${ROOT_FILES[@]}"; do
            [[ -e "$SCRIPT_DIR/$file" || -L "$SCRIPT_DIR/$file" ]] \
                && die "Working files are not attached to a profile. Save them or use --force."
        done
        for file in "${SECTION_FILES[@]}"; do
            [[ -e "$SECTIONS_DIR/$file" || -L "$SECTIONS_DIR/$file" ]] \
                && die "Working files are not attached to a profile. Save them or use --force."
        done
        return 0
    fi
    profile_exists "$current" || die "Active profile '$current' is missing. Repair .active_profile or use --force."
    if working_tree_differs_from_profile "$current"; then
        die "Working files differ from active profile '$current'. Run './cv save' first or use --force."
    fi
}

sync_file() {
    local source="$1"
    local destination="$2"
    [[ ! -L "$source" ]] || die "Refusing to copy symbolic link: $source"
    rm -f "$destination"
    if [[ -f "$source" ]]; then
        cp "$source" "$destination"
    fi
    return 0
}

sync_profile_pdfs() {
    local profile_dir="$1"
    [[ ! -L "$BUILD_DIR" ]] || die "build/ must not be a symbolic link when saving PDFs."
    local existing pdf destination
    local -a pdf_sources=()
    for pdf in "$BUILD_DIR"/*.pdf; do
        [[ -e "$pdf" ]] || continue
        [[ ! -L "$pdf" && -f "$pdf" ]] || die "Refusing unsafe PDF source: $pdf"
        pdf_sources+=("$pdf")
    done
    ((${#pdf_sources[@]} > 0)) || return 0
    for existing in "$profile_dir"/*.pdf; do
        [[ -e "$existing" || -L "$existing" ]] && rm -f "$existing"
    done
    for pdf in "${pdf_sources[@]}"; do
        destination="$profile_dir/$(basename "$pdf")"
        rm -f "$destination"
        cp "$pdf" "$destination"
    done
}

profile_exists() {
    validate_profile_name "$1"
    ensure_profiles_root
    if [[ -L "$PROFILES_DIR/$1" ]]; then
        die "Profile '$1' must not be a symbolic link."
    fi
    if [[ -d "$PROFILES_DIR/$1" ]]; then
        assert_safe_profile_dir "$1"
        return 0
    fi
    return 1
}

available_profiles() {
    ensure_profiles_root
    local path name
    for path in "$PROFILES_DIR"/*; do
        [[ -d "$path" && ! -L "$path" ]] || continue
        name=$(basename "$path")
        [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [[ "$name" != *..* ]] || continue
        printf '%s ' "$name"
    done
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_list() {
    ensure_profiles_root
    local current
    current=$(get_current)

    if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR" 2>/dev/null)" ]]; then
        echo "No profiles found. Create one with: ./cv save <name>"
        return
    fi

    printf "\n${BOLD}  Profiles${RESET}\n\n"

    for dir in "$PROFILES_DIR"/*/; do
        [[ -d "$dir" && ! -L "${dir%/}" ]] || continue
        local name
        name=$(basename "$dir")

        # Active marker
        local marker="  "
        [[ "$name" == "$current" ]] && marker="${GREEN}▸ ${RESET}"

        # PDF indicator
        local pdf_status="${DIM}no PDFs${RESET}"
        if find "$dir" -maxdepth 1 -name '*_CV.pdf' -print -quit | grep -q . \
            && find "$dir" -maxdepth 1 -name '*_Cover_Letter.pdf' -print -quit | grep -q .; then
            pdf_status="${GREEN}CV + CL${RESET}"
        elif find "$dir" -maxdepth 1 -name '*_CV.pdf' -print -quit | grep -q .; then
            pdf_status="${YELLOW}CV only${RESET}"
        fi

        # Count customized section files
        local sec_count=0
        for f in "${SECTION_FILES[@]}"; do
            [[ -f "$dir/sections/$f" ]] && ((sec_count += 1))
        done

        printf "  %b%-16s  %b  ${DIM}(%d sections)${RESET}\n" "$marker" "$name" "$pdf_status" "$sec_count"
    done
    echo
}

cmd_use() {
    local profile="${1:?Usage: ./cv use <profile>}"
    local force="${2:-}"
    profile_exists "$profile" || die "Profile '$profile' not found. Available: $(available_profiles)"
    assert_profile_files_are_regular "$PROFILES_DIR/$profile"
    ensure_switch_is_safe "$force"

    local profile_dir="$PROFILES_DIR/$profile"
    [[ ! -L "$SECTIONS_DIR" ]] || die "sections/ must not be a symbolic link."

    # Replace the working snapshot exactly. Leaving a missing file in place can
    # silently carry a previous employer or claim into the selected profile.
    for f in "${ROOT_FILES[@]}"; do
        rm -f "$SCRIPT_DIR/$f"
        [[ -f "$profile_dir/$f" ]] && cp "$profile_dir/$f" "$SCRIPT_DIR/$f"
    done

    # Copy section files
    mkdir -p "$SECTIONS_DIR"
    for f in "${SECTION_FILES[@]}"; do
        rm -f "$SECTIONS_DIR/$f"
        [[ -f "$profile_dir/sections/$f" ]] && cp "$profile_dir/sections/$f" "$SECTIONS_DIR/$f"
    done

    write_active "$profile"
    echo -e "${GREEN}✓${RESET} Loaded profile: ${BOLD}$profile${RESET}"
}

cmd_save() {
    local profile="${1:-$(get_current)}"
    [[ -n "$profile" ]] || die "No profile name given and no active profile.\nUsage: ./cv save <profile>"
    validate_profile_name "$profile"
    ensure_profiles_root
    assert_working_files_are_regular

    local current
    current=$(get_current)
    if [[ -n "${1:-}" ]] && [[ -n "$current" ]] && [[ "$1" != "$current" ]]; then
        die "Cannot save to profile '$1' because active working profile is '$current'. Switch first with './cv use $1'."
    fi

    local profile_dir="$PROFILES_DIR/$profile"
    [[ ! -L "$SECTIONS_DIR" ]] || die "sections/ must not be a symbolic link."
    if [[ -e "$profile_dir" || -L "$profile_dir" ]]; then
        assert_safe_profile_dir "$profile"
    else
        mkdir -p "$profile_dir/sections"
    fi
    [[ ! -L "$profile_dir/sections" ]] || die "Profile '$profile' has an unsafe sections symlink."
    mkdir -p "$profile_dir/sections"

    # Synchronize source exactly so a removed working file cannot leave stale
    # employer or claim data in the profile.
    for f in "${ROOT_FILES[@]}"; do
        sync_file "$SCRIPT_DIR/$f" "$profile_dir/$f"
    done

    for f in "${SECTION_FILES[@]}"; do
        sync_file "$SECTIONS_DIR/$f" "$profile_dir/sections/$f"
    done

    sync_profile_pdfs "$profile_dir"

    write_active "$profile"
    echo -e "${GREEN}✓${RESET} Saved profile: ${BOLD}$profile${RESET}"
}

cmd_build() {
    local profile="${1:-}"
    assert_working_files_are_regular

    # No profile specified → build current working version
    if [[ -z "$profile" ]]; then
        assert_visible_skills_file "$SECTIONS_DIR/skills.tex"
        echo -e "${CYAN}Building current working version...${RESET}"
        make -C "$SCRIPT_DIR" all
        return
    fi

    profile_exists "$profile" || die "Profile '$profile' not found. Available: $(available_profiles)"

    local profile_dir="$PROFILES_DIR/$profile"
    assert_visible_skills_file "$profile_dir/sections/skills.tex"

    # ── Snapshot current state ──
    local tmp_dir
    tmp_dir=$(mktemp -d)
    for f in "${ROOT_FILES[@]}"; do
        [[ -f "$SCRIPT_DIR/$f" ]] && cp "$SCRIPT_DIR/$f" "$tmp_dir/$f"
    done
    mkdir -p "$tmp_dir/sections"
    for f in "${SECTION_FILES[@]}"; do
        [[ -f "$SECTIONS_DIR/$f" ]] && cp "$SECTIONS_DIR/$f" "$tmp_dir/sections/$f"
    done
    local prev_profile
    prev_profile=$(get_current)
    local had_active=false
    [[ -f "$ACTIVE_FILE" ]] && had_active=true

    restore_build_state() {
        [[ -d "$tmp_dir" ]] || return 0
        local file
        for file in "${ROOT_FILES[@]}"; do
            rm -f "$SCRIPT_DIR/$file"
            [[ -f "$tmp_dir/$file" ]] && cp "$tmp_dir/$file" "$SCRIPT_DIR/$file"
        done
        for file in "${SECTION_FILES[@]}"; do
            rm -f "$SECTIONS_DIR/$file"
            [[ -f "$tmp_dir/sections/$file" ]] && cp "$tmp_dir/sections/$file" "$SECTIONS_DIR/$file"
        done
        if $had_active; then
            write_active "$prev_profile"
        else
            rm -f "$ACTIVE_FILE"
        fi
        rm -rf "$tmp_dir"
    }
    trap restore_build_state EXIT INT TERM

    # ── Build target profile ──
    # Keep failures inside an explicit conditional. Relying only on a global
    # EXIT trap after `set -e` is not portable: some Bash versions unwind the
    # function's local variables before the trap can restore the snapshot.
    echo -e "${CYAN}Building profile: ${BOLD}$profile${RESET}"
    local build_status=0
    if cmd_use "$profile" --force > /dev/null \
        && make -C "$SCRIPT_DIR" clean all \
        && sync_profile_pdfs "$profile_dir"; then
        build_status=0
    else
        build_status=$?
    fi

    # ── Restore previous state before returning success or failure ──
    restore_build_state
    trap - EXIT INT TERM

    if ((build_status != 0)); then
        return "$build_status"
    fi

    echo -e "${GREEN}✓${RESET} Built profile: ${BOLD}$profile${RESET} → profiles/$profile/"
}

cmd_new() {
    local profile="${1:?Usage: ./cv new <profile>}"
    validate_profile_name "$profile"
    ensure_switch_is_safe ""
    profile_exists "$profile" && die "Profile '$profile' already exists. Use './cv save $profile' to update it."

    local profile_dir="$PROFILES_DIR/$profile"
    mkdir -p "$profile_dir/sections"

    if [[ -f "$SCRIPT_DIR/templates/config.tex.example" ]]; then
        cp "$SCRIPT_DIR/templates/config.tex.example" "$profile_dir/config.tex"
    fi
    if [[ -f "$SCRIPT_DIR/templates/letter_config.tex.example" ]]; then
        cp "$SCRIPT_DIR/templates/letter_config.tex.example" "$profile_dir/letter_config.tex"
    fi
    for f in "${SECTION_FILES[@]}"; do
        if [[ -f "$SCRIPT_DIR/templates/sections/$f" ]]; then
            cp "$SCRIPT_DIR/templates/sections/$f" "$profile_dir/sections/$f"
        elif [[ -f "$SECTIONS_DIR/$f" ]]; then
            cp "$SECTIONS_DIR/$f" "$profile_dir/sections/$f"
        fi
    done

    cmd_use "$profile" --force > /dev/null
    echo -e "${GREEN}✓${RESET} Created new clean profile: ${BOLD}$profile${RESET}"
    echo -e "  ${DIM}Tip: edit files in root or profiles/$profile/, then run './cv build $profile'${RESET}"
}

cmd_clone() {
    local source="${1:?Usage: ./cv clone <source> <new-profile>}"
    local target="${2:?Usage: ./cv clone <source> <new-profile>}"
    profile_exists "$source" || die "Profile '$source' not found."
    assert_profile_files_are_regular "$PROFILES_DIR/$source"
    validate_profile_name "$target"
    ensure_switch_is_safe ""
    ! profile_exists "$target" || die "Profile '$target' already exists."

    local source_dir="$PROFILES_DIR/$source"
    local target_dir="$PROFILES_DIR/$target"
    mkdir -p "$target_dir/sections"
    local file
    for file in "${ROOT_FILES[@]}"; do
        [[ -f "$source_dir/$file" ]] && cp "$source_dir/$file" "$target_dir/$file"
    done
    for file in "${SECTION_FILES[@]}"; do
        [[ -f "$source_dir/sections/$file" ]] && cp "$source_dir/sections/$file" "$target_dir/sections/$file"
    done
    cmd_use "$target" --force > /dev/null
    echo -e "${GREEN}✓${RESET} Cloned ${BOLD}$source${RESET} → ${BOLD}$target${RESET} (source files only)"
}

