  ./cv privacy-check
  ./cv pdf-audit build/Alex_Example_CV.pdf
  ./cv bundle-audit meta/applications/<id>/application.yaml
  ./cv track summary
  ./cv doctor

${BOLD}What's in a profile:${RESET}
  config.tex, letter_config.tex, sections/*.tex, and compiled PDFs.
  Structural files (src/main.tex, src/coverletter.tex, src/awesome-cv.cls) are shared.

EOF
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
case "${1:-}" in
    init)    shift; cmd_init "$@" ;;
    list)    cmd_list ;;
    use)     cmd_use "${2:-}" "${3:-}" ;;
    save)    cmd_save "${2:-}" ;;
    build)   cmd_build "${2:-}" ;;
    new)     cmd_new "${2:-}" ;;
    clone)   cmd_clone "${2:-}" "${3:-}" ;;
    diff)    cmd_diff "${2:-}" "${3:-}" ;;
    current) cmd_current ;;
    archive) shift; cmd_archive "$@" ;;
    archive-research) shift; cmd_archive_research "$@" ;;
    github-audit) shift; cmd_github_audit "$@" ;;
    portfolio-audit) shift; cmd_portfolio_audit "$@" ;;
    role-audit) shift; cmd_role_audit "$@" ;;
    legacy-audit) shift; cmd_legacy_audit "$@" ;;
    tech-audit) shift; cmd_tech_audit "$@" ;;
    delete)  cmd_delete "${2:-}" ;;
    context) shift; cmd_context "$@" ;;
    status) shift; cmd_status "$@" ;;
    start) shift; cmd_start "$@" ;;
    manifest) shift; cmd_manifest "$@" ;;
    validate) shift; cmd_validate "$@" ;;
    privacy-check) shift; cmd_privacy_check "$@" ;;
    pdf-audit) shift; cmd_pdf_audit "$@" ;;
    bundle-audit) shift; cmd_bundle_audit "$@" ;;
    track) shift; cmd_track "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    -h|--help|help) usage ;;
    "")      cmd_interactive ;;
    *)       echo -e "${RED}Unknown command:${RESET} $1"; usage; exit 1 ;;
esac
