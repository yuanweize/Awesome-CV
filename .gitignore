### TeX ###
## Core latex/pdflatex auxiliary files:
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.synctex.gz

## Intermediate documents:
*.dvi
*-converted-to.*

## Build outputs
*.pdf
/build/

### Editor ###
## VS Code workspace settings:
.vscode/*
!.vscode/settings.json
## Vim & Emacs temp files:
.*sw[op]
*~

### Mac OS X ###
*.DS_Store

### Python ###
.venv/
__pycache__/
*.py[cod]

# Local QA and generated AI context
/tmp/
*.generated.md
*.difypkg

#-------------------------------------------------------------------------------
# PRIVACY - NEVER COMMIT SENSITIVE PRIVATE DATA
#-------------------------------------------------------------------------------
# Personal configuration (contains real PII)
/config.tex

# Per-application letter configuration
/letter_config.tex

# Real content directory (contains your actual CV content)
/sections/

# Private master database, evidence, interview notes, and personal research.
# Public guidance belongs in docs/, never in meta/.
/meta/

# Per-company profiles (managed by ./cv)
/profiles/

# Optional long-lived layout/role baselines; private and never factual authority
/baselines/
/.active_profile

# Closed applications and private research archives. Archive manifests may
# contain private filenames even when they do not contain file contents.
/archive/

# Server scan reports (private IPs and node info)
tools/tech-stack-collector/reports/*
!tools/tech-stack-collector/reports/.gitkeep
tools/tech-stack-collector/targets.yaml
tools/tech-stack-collector/targets.json

# Secrets and local credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets*.yaml
secrets*.yml

# Handoff / internal notes
PROJECT_HANDOFF.md
